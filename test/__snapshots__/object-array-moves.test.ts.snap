// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`object array moves > a move combined with an added and a removed item 1`] = `
[
  {
    "patch": {
      "id": "blocks",
      "unset": [
        "body[_key=="c1"]",
        "body[_key=="e1"]",
      ],
    },
  },
  {
    "patch": {
      "id": "blocks",
      "insert": {
        "before": "body[_key=="a1"]",
        "items": [
          {
            "_key": "e1",
            "_type": "block",
            "text": "Echo",
          },
        ],
      },
    },
  },
  {
    "patch": {
      "id": "blocks",
      "insert": {
        "after": "body[_key=="a1"]",
        "items": [
          {
            "_key": "f1",
            "_type": "block",
            "text": "Foxtrot",
          },
        ],
      },
    },
  },
]
`;

exports[`object array moves > a move keeps the text diff of a stable item 1`] = `
[
  {
    "patch": {
      "diffMatchPatch": {
        "body[_key=="b1"].text": "@@ -1,5 +1,9 @@
 Bravo
+ Two
",
      },
      "id": "blocks",
    },
  },
  {
    "patch": {
      "id": "blocks",
      "unset": [
        "body[_key=="e1"]",
      ],
    },
  },
  {
    "patch": {
      "id": "blocks",
      "insert": {
        "before": "body[_key=="a1"]",
        "items": [
          {
            "_key": "e1",
            "_type": "block",
            "text": "Echo",
          },
        ],
      },
    },
  },
]
`;

