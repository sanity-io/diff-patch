{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>sanity-io/renovate-config", ":reviewer(team:sdk)"],
  "ignorePresets": [":ignoreModulesAndTests", "github>sanity-io/renovate-config:group-non-major"],
  "packageRules": [
    {
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Batch non-major devDependency updates into a single PR, instead of one PR per package",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": [
        "bump",
        "digest",
        "lockfileUpdate",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "replacement",
        "rollback"
      ],
      "groupName": "dev dependencies (non-major)",
      "groupSlug": "dev-deps-non-major"
    }
  ]
}
